pipeline {
    agent any
    environment {
        SERVER_IP = '172.31.26.189'
        SSH_CREDENTIAL = 'gym-key' // Make sure Jenkins Credentials ID is exactly this
        REPO_URL = 'https://github.com/rohi-del/gym-static-website.git'
        BRANCH = 'main'
        REMOTE_USER = 'ubuntu'
        REMOTE_PATH = '/var/www/html'
    }
    stages {
        stage('Clone Repository') {
            steps {
                // checkout scm use karna better practice hai declarative pipeline mein
                git branch: "${BRANCH}", url: "${REPO_URL}"
            }
        }
        
        stage('Deploy to Target Server') {
            steps {
                // Yahan quotes hata diye hain variable se
                sshagent([SSH_CREDENTIAL]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} 'sudo mkdir -p ${REMOTE_PATH} && sudo chown -R ${REMOTE_USER}:${REMOTE_USER} ${REMOTE_PATH}'
                        scp -o StrictHostKeyChecking=no -r * ${REMOTE_USER}@${SERVER_IP}:${REMOTE_PATH}
                    """
                }
            }
        }

        stage('Restart nginx') {
            steps {
                sshagent([SSH_CREDENTIAL]) {
                    sh "ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} 'sudo systemctl restart nginx'"
                }
            }
        }
    }
    post {
        success { echo 'Deployment Successful ✅' }
        failure { echo 'Deployment Failed ❌' }
    }
}